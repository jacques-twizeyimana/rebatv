# MariaDB connection (mysql:// URL). On Vercel this must also be available at build time,
# because public pages are prerendered from the database.
DATABASE_URL=mysql://rebatv:rebatv@127.0.0.1:3306/rebatv

# 32+ random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Public origin, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
