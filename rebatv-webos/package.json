{
  "name": "rebatv-webos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && es-check es2016 \"dist/assets/*.js\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "package": "pnpm build && node scripts/package-webos.mjs",
    "install:tv": "node scripts/tv.mjs install",
    "launch:tv": "node scripts/tv.mjs launch"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/figtree": "5.3.0",
    "core-js": "3.50.0",
    "hls.js": "1.7.3",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@preact/preset-vite": "2.10.6",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.20.5",
    "@webos-tools/cli": "3.2.6",
    "es-check": "9.8.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@10.33.2"
}
